# Set these as process environment variables. This file is a template, not loaded automatically.
APP_ENV=development
HOST=127.0.0.1
PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1
API_DOCS=true
DATABASE_URL=sqlite:///data/application.db
# MySQL: mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/at_risk?charset=utf8mb4
COOKIE_SECURE=false
EMAIL_MODE=preview
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# DEMO_SEED=1 initializes synthetic accounts/data only in an empty database.
DEMO_SEED=1
FORWARDED_ALLOW_IPS=127.0.0.1
